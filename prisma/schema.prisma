// Deez Prints — Prisma Schema for Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String
  email     String?
  city      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@map("customers")
}

model Order {
  id             String      @id @default(uuid())
  orderId        String      @unique // Human readable e.g. DP-20260801-00001
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  notes          String?
  paymentMethod  String
  orderType      String      @default("normal") // normal | custom
  subtotal       Float
  shipping       Float
  discount       Float       @default(0)
  total          Float
  status         String      @default("Pending") // Pending | Processing | Dispatched | Delivered | Cancelled
  statusHistory  Json        // Array of { status, date, note }
  trackingNumber String?
  deliveryLocation String?   // e.g. "Karachi", "Nationwide Pakistan"
  shippingMethod   String?   // e.g. "Bykea", "Courier"
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]

  // Legacy columns — still in production DB, kept to prevent prisma db push from dropping them.
  // App reads customer data via the Customer relation above.
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  customerCity    String?
  customerAddress String?

  @@index([status])
  @@index([createdAt])
  @@index([orderId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title           String
  size            String?
  color           String?
  qty             Int      @default(1)
  price           Float
  isCustom        Boolean  @default(false)
  frontArtworkUrl String?
  backArtworkUrl  String?
  placement       String?
  blankItem       String?
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model AdminSettings {
  id                   String   @id @default("singleton")
  telegramBotToken     String   @default("8851777111:AAHEWoRMMes229DTTljUDT5SiDFV-fU-iwM")
  telegramChatId       String   @default("6105402097")
  telegramApiBase      String   @default("https://api.telegram.org")
  enableNotifications  Boolean  @default(true)
  sendArtwork          Boolean  @default(true)
  compressImages       Boolean  @default(false)
  notifyStatusChanges Boolean  @default(true)
  storeName            String   @default("Deez Prints")
  whatsappNumber       String   @default("923272487127")
  currency             String   @default("PKR")
  orderPrefix          String   @default("DP")
  passwordHash         String   @default("1661623862") // default hash for deez123
  updatedAt            DateTime @updatedAt

  @@map("admin_settings")
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   Json?
  orderId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("activity_logs")
}

model ProductOverride {
  id        String   @id // product id e.g. "kanye-yeezus-shirt"
  data      Json     // { title?, price?, description?, sizes?, colors? }
  updatedAt DateTime @updatedAt

  @@map("product_overrides")
}
