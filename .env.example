# Deez Prints Environment Variables
# Copy this file to .env and insert your Neon PostgreSQL connection strings.

# Pooled connection string for server queries (e.g. from Neon dashboard connection details)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
